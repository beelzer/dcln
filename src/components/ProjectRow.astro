---
interface Props {
  title: string;
  description: string;
  tags: string[];
  slug: string;
  url?: string;
  repo?: string;
}

const { title, description, tags, slug, url, repo } = Astro.props;
---

<article class="row">
  <h2 class="row__title"><a href={`/projects/${slug}`}>{title}</a></h2>
  <p class="row__desc">{description}</p>
  <div class="row__meta">
    <ul class="tags">{tags.map((tag) => <li>{tag}</li>)}</ul>
    <ul class="links">
      {
        url && (
          <li>
            <a href={url} target="_blank" rel="noopener noreferrer">
              Live<span class="sr-only"> (opens in new window)</span>
            </a>
          </li>
        )
      }
      {
        repo && (
          <li>
            <a href={repo} target="_blank" rel="noopener noreferrer">
              Source<span class="sr-only"> (opens in new window)</span>
            </a>
          </li>
        )
      }
    </ul>
  </div>
</article>

<style>
  .row {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .row__title {
    font-size: var(--text-lg);

    a {
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .row__desc {
    margin: var(--space-xs) 0 var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
  }
</style>
