---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { SITE, THEME } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// OG images are only generated for the home, about, and projects pages
// (see src/pages/og/[...route].png.ts) — everything else (private area,
// error pages) falls back to the site-wide image.
const hasOwnOgImage = /^\/(about|projects(\/.+)?)\/?$/.test(Astro.url.pathname);
const ogRoute = hasOwnOgImage ? Astro.url.pathname.replace(/^\/|\/$/g, '') : 'index';
const ogImage = new URL(`/og/${ogRoute}.png`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={THEME.bg} />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow" />

    <!-- Structured Data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE.name,
        url: Astro.site?.href,
        sameAs: [SITE.github],
      })}
    />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--gutter);
    z-index: calc(var(--z-header) + 1);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-accent);
    color: #fff;
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
    text-decoration: none;

    &:focus {
      top: var(--space-sm);
    }
  }

  main {
    /* header + footer approximate combined height */
    min-height: calc(100dvh - var(--header-height) - 80px);
  }
</style>
