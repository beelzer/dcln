---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/constants';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title={`Projects — ${SITE.name}`} description="Projects and experiments">
  <section class="page container">
    <h1 class="page__title">Projects</h1>
    <p class="page__lede">Things I've built and tinkered with, newest first.</p>

    <div class="project-list">
      {
        projects.map((project) => (
          <ProjectRow
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            slug={project.id}
            url={project.data.url}
            repo={project.data.repo}
          />
        ))
      }
    </div>

    {projects.length === 0 && <p class="empty">No projects yet.</p>}
  </section>
</BaseLayout>

<style>
  .empty {
    padding: var(--space-2xl) 0;
    color: var(--color-text-muted);
  }
</style>
