---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../lib/constants';
import { fetchReadmeHtml } from '../../lib/github';
import '../../styles/markdown.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const readmeHtml =
  project.data.readme && project.data.repo ? await fetchReadmeHtml(project.data.repo) : null;

// A failed README fetch falls back to <Content />; if the entry has no
// body either, the page would silently ship empty — fail the build instead.
if (project.data.readme && !readmeHtml && !project.body?.trim()) {
  throw new Error(
    `README fetch failed for "${project.id}" and the entry has no fallback body. ` +
      'Set GITHUB_TOKEN to avoid API rate limits, or add body content to the markdown file.',
  );
}

const hasLinks = Boolean(project.data.url || project.data.repo);
---

<BaseLayout title={`${project.data.title} — ${SITE.name}`} description={project.data.description}>
  <article class="page container">
    <BackLink href="/projects" label="All projects" />
    <h1 class="page__title">{project.data.title}</h1>
    <p class="page__lede">{project.data.description}</p>

    <dl class="meta project__meta">
      <dt>Stack</dt>
      <dd>
        <ul class="tags">{project.data.tags.map((tag) => <li>{tag}</li>)}</ul>
      </dd>
      {
        hasLinks && (
          <Fragment>
            <dt>Links</dt>
            <dd>
              <ul class="links">
                {project.data.url && (
                  <li>
                    <a href={project.data.url} target="_blank" rel="noopener noreferrer">
                      Live<span class="sr-only"> (opens in new window)</span>
                    </a>
                  </li>
                )}
                {project.data.repo && (
                  <li>
                    <a href={project.data.repo} target="_blank" rel="noopener noreferrer">
                      Source<span class="sr-only"> (opens in new window)</span>
                    </a>
                  </li>
                )}
              </ul>
            </dd>
          </Fragment>
        )
      }
    </dl>

    <div class="project__content">
      {readmeHtml ? <Fragment set:html={readmeHtml} /> : <Content />}
    </div>
  </article>
</BaseLayout>

<style>
  .project__meta {
    margin-bottom: var(--space-xl);
  }
</style>
