---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/constants';

const all = (await getCollection('projects')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featured = all.filter((p) => p.data.featured);
const projects = (featured.length > 0 ? featured : all).slice(0, SITE.featuredProjectsLimit);
---

<BaseLayout>
  <section class="page container">
    <h1 class="intro">{SITE.description}</h1>

    <div class="project-list">
      {
        projects.map((project) => (
          <ProjectRow
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            slug={project.id}
            url={project.data.url}
            repo={project.data.repo}
          />
        ))
      }
    </div>

    {
      all.length > projects.length && (
        <p class="more">
          <a href="/projects">All projects &rarr;</a>
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .intro {
    font-size: var(--text-xl);
    font-weight: 500;
    margin-bottom: var(--space-xl);
    max-width: 36ch;
  }

  .more {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
  }
</style>
