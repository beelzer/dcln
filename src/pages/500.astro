---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/constants';
---

<BaseLayout title={`500 — ${SITE.name}`} description="Something went wrong">
  <section class="page container">
    <h1 class="page__title">500</h1>
    <p class="page__lede">Something went wrong. Please try again later.</p>
    <a href="/" class="btn">Go home</a>
  </section>
</BaseLayout>
