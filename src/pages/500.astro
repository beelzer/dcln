---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/constants';
---

<BaseLayout title={`500 — ${SITE.name}`} description="Something went wrong">
  <section class="error">
    <div class="container container--narrow">
      <p class="error__code" aria-hidden="true">500</p>
      <h1 class="error__title">Something went wrong</h1>
      <p class="error__desc">An unexpected error occurred. Please try again later.</p>
      <a href="/" class="btn btn--ghost">
        <Icon name="arrow-left" size={14} />
        Go home
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .error {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(80dvh - var(--header-height));
    padding: var(--space-4xl) 0;
    text-align: center;
  }

  .error__code {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-5xl);
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .error__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-md);
  }

  .error__desc {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }
</style>
