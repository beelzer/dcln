---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/constants';

const stack = ['TypeScript', 'Astro', 'React', 'Node.js', 'CSS', 'Cloudflare', 'Git'];
---

<BaseLayout title={`About — ${SITE.name}`} description={`About ${SITE.author}`}>
  <section class="about">
    <div class="container about__grid">
      <aside class="about__aside">
        <p class="eyebrow">About</p>
      </aside>

      <div class="about__main">
        <h1 class="about__title">Hi, I'm {SITE.author}.</h1>

        <p class="lede">
          {SITE.tagline} This site is a collection of projects I've worked on, mostly vibe coded experiments
          and tools.
        </p>

        <p class="about__body">
          I'm interested in modern web technologies, clean design, and shipping things that work.
        </p>

        <section class="about__section reveal">
          <h2 class="about__heading">Tech I use</h2>
          <ul class="tags tags--lg">{stack.map((tech) => <li>{tech}</li>)}</ul>
        </section>

        <section class="about__section reveal">
          <h2 class="about__heading">Get in touch</h2>
          <ul class="links links--col">
            <li>
              <a href={`mailto:${SITE.email}`}>
                <Icon name="mail" size={16} />
                {SITE.email}
              </a>
            </li>
            <li>
              <a href={SITE.github} target="_blank" rel="noopener noreferrer">
                <Icon name="github" size={16} />
                {SITE.github.replace('https://', '')}
                <span class="sr-only"> (opens in new window)</span>
              </a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding: var(--space-3xl) 0;
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg) var(--space-3xl);
  }

  .about__main {
    max-width: var(--content-width);
  }

  .about__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-xl);
  }

  .about__body {
    margin-top: var(--space-lg);
    max-width: 60ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .about__section {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .about__heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-md);
  }

  @media (min-width: 768px) {
    .about__grid {
      grid-template-columns: 9rem 1fr;
    }

    .about__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
      align-self: start;
      padding-top: 0.9rem;
    }
  }
</style>
