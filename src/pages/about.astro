---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/constants';

const stack = ['TypeScript', 'Astro', 'React', 'Node.js', 'CSS', 'Cloudflare', 'Git'];
---

<BaseLayout title={`About — ${SITE.name}`} description="About this site">
  <section class="page container about">
    <h1 class="page__title">About</h1>

    <p>This site is a collection of small projects and experiments for the web.</p>
    <p>I'm interested in modern web technologies, clean design, and shipping things that work.</p>

    <h2>Tech</h2>
    <ul class="tags tags--lg">{stack.map((tech) => <li>{tech}</li>)}</ul>

    <h2>Contact</h2>
    <ul class="links links--col">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">
          {SITE.github.replace('https://', '')}
          <span class="sr-only"> (opens in new window)</span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .about p {
    max-width: 60ch;
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
  }

  .about h2 {
    margin: var(--space-xl) 0 var(--space-sm);
  }
</style>
